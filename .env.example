# Contentful space ID and Content Delivery API token.
# Leave empty to run the site on built-in mock reviews.
PUBLIC_cSPACE=
PUBLIC_cACCESS_TOKEN=

# Optional: Contentful environment (defaults to master)
# CONTENTFUL_ENVIRONMENT=master

# Optional: content type ID of the Reviews model (defaults to "reviews")
# CONTENTFUL_REVIEW_TYPE=reviews

# Remark42 comments. Leave the host empty to show "Comments are coming soon".
# Host is the URL of your Remark42 server, e.g. https://comments.vizune.net
PUBLIC_REMARK42_HOST=
# Must match SITE on the Remark42 server (defaults to "remark")
# PUBLIC_REMARK42_SITE_ID=remark

# Public address of this site, so each review keeps one comment thread
# even when you test locally, e.g. https://vizune.nekoweb.org
# PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Leave empty to turn analytics off, e.g. for local development.
PUBLIC_GA_ID=

# Contentful space ID and Content Delivery API token.
# Leave empty to run the site on built-in mock reviews.
PUBLIC_cSPACE=
PUBLIC_cACCESS_TOKEN=

# Optional: Contentful environment (defaults to master)
# CONTENTFUL_ENVIRONMENT=master

# Optional: content type ID of the Reviews model (defaults to "reviews")
# CONTENTFUL_REVIEW_TYPE=reviews

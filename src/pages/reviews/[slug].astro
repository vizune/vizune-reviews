---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { getReviews } from '../../lib/contentful';
import { formatDate, pad2 } from '../../lib/format';
import { contentfulImage, contentfulSrcset } from '../../lib/images';
import { IMAGE_SIZES, placeholdFor } from '../../lib/placeholder';
import { REVIEW_IMAGE_SIZES, renderRichText } from '../../lib/rich-text';
import type { Review } from '../../lib/types';

export const getStaticPaths = (async () => {
  const reviews = await getReviews();
  return reviews.map((review) => ({ params: { slug: review.slug }, props: { review } }));
}) satisfies GetStaticPaths;

interface Props {
  review: Review;
}

const { review } = Astro.props;
const EMPTY_MESSAGE = 'This review is still being written.';
const html = renderRichText(review.content, REVIEW_IMAGE_SIZES);
const [w, h] = IMAGE_SIZES.reviewFeature;
const banner = review.bannerUrl;

// Real Contentful entries (not mock data) re-check for edits in the browser
const live = Boolean(import.meta.env.PUBLIC_cSPACE && import.meta.env.PUBLIC_cACCESS_TOKEN && !review.id.startsWith('mock-'));
const environment = import.meta.env.CONTENTFUL_ENVIRONMENT || 'master';
---

<BaseLayout title={`${review.subject} Review`} description={review.excerpt || review.headline}>
  <article
    class="container review"
    data-entry-id={live ? review.id : undefined}
    data-environment={environment}
  >
    <nav class="crumbs label" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/reviews">Reviews</a></li>
        <li aria-current="page">{review.subject}</li>
      </ol>
    </nav>

    <header class="review__head">
      <p class="review__file label" aria-hidden="true">
        <span class="accent">▸ File</span> <span class="review__sep">//</span> ARC-{pad2(review.index)}
        <span class="review__tag">Review</span>
      </p>
      {/* The tag above is decorative, so screen readers still hear "Crystar Review" here */}
      <h1 class="review__title display">
        {review.subject}<span class="visually-hidden"> Review</span>
      </h1>
      <p class="review__dek">{review.headline}</p>

      <div class="review__meta label">
        <time datetime={review.publishDate}>{formatDate(review.publishDate)}</time>
        <span class="review__sep" aria-hidden="true">//</span>
        <a class="review__comments" href="#comments">
          <Icon name="comment" size={15} />
          Comments
        </a>
      </div>
    </header>

    <figure class="review__banner">
      <img
        src={banner ? contentfulImage(banner, 1200) : placeholdFor('reviewFeature')}
        srcset={banner ? contentfulSrcset(banner, [600, 900, 1200]) : undefined}
        sizes="(min-width: 1100px) 1000px, calc(100vw - 2 * var(--gutter))"
        width={w}
        height={h}
        alt=""
        fetchpriority="high"
      />
      <span class="brackets" aria-hidden="true"></span>
    </figure>

    <div class="review__body">
      <div class="prose" set:html={html || `<p>${EMPTY_MESSAGE}</p>`} />
    </div>

    <section class="review__comments-section" id="comments" aria-labelledby="comments-title">
      <h2 id="comments-title" class="label">Comments</h2>
      <p>Comments are coming soon.</p>
    </section>

    <div class="review__back">
      <Button href="/reviews" arrow>All reviews</Button>
    </div>
  </article>
</BaseLayout>

<script>
  import { fetchLiveReview } from '../../lib/live-review';
  import { REVIEW_IMAGE_SIZES, renderRichText } from '../../lib/rich-text';
  import { contentfulImage, contentfulSrcset } from '../../lib/images';
  import { formatDate } from '../../lib/format';

  // The page ships with the content from its last build; this swaps in any
  // edits made in Contentful since, so the page never needs re-uploading.
  const article = document.querySelector<HTMLElement>('.review[data-entry-id]');

  async function refresh(el: HTMLElement) {
    const space = import.meta.env.PUBLIC_cSPACE;
    const token = import.meta.env.PUBLIC_cACCESS_TOKEN;
    const entryId = el.dataset.entryId;
    if (!space || !token || !entryId) return;

    const review = await fetchLiveReview({
      space,
      token,
      environment: el.dataset.environment ?? 'master',
      entryId,
    });
    if (!review) return;

    const dek = el.querySelector('.review__dek');
    if (dek && review.headline && dek.textContent !== review.headline) dek.textContent = review.headline;

    const time = el.querySelector('.review__meta time');
    if (time && review.publishDate && time.getAttribute('datetime') !== review.publishDate) {
      time.setAttribute('datetime', review.publishDate);
      time.textContent = formatDate(review.publishDate);
    }

    const img = el.querySelector<HTMLImageElement>('.review__banner img');
    if (img && review.bannerUrl && !img.src.startsWith(review.bannerUrl)) {
      img.srcset = contentfulSrcset(review.bannerUrl, [600, 900, 1200]);
      img.src = contentfulImage(review.bannerUrl, 1200);
    }

    const prose = el.querySelector('.review__body .prose');
    const html = renderRichText(review.content, REVIEW_IMAGE_SIZES) || '<p>This review is still being written.</p>';
    if (prose && prose.innerHTML !== html) prose.innerHTML = html;
  }

  // If Contentful can't be reached, the built version simply stays.
  if (article) refresh(article).catch(() => {});
</script>

<style>
  /* 1000px column for heading and banner, like IGN */
  .review {
    max-width: calc(62.5rem + var(--gutter) * 2);
    /* Same top spacing as the other pages (About, Reviews) */
    padding-block: var(--section-gap);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--faint);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 0.6rem;
    color: var(--accent);
    opacity: 0.6;
  }

  .crumbs a {
    color: var(--accent);
  }

  /* The game name "locks on" once as the page arrives */
  .crumbs [aria-current='page'] {
    animation: hud-acquire 0.7s steps(1) 0.35s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .crumbs [aria-current='page'] {
      animation: none;
    }
  }

  .crumbs a:hover {
    color: var(--accent-strong);
  }

  .review__head {
    position: relative;
    margin: 1.75rem 0 1.75rem;
  }

  /* Case-file label above the title */
  .review__file {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
  }

  .review__title {
    margin-top: 0.9rem;
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1.1;
  }

  /* "REVIEW" as a small teal HUD tag at the end of the file row */
  .review__tag {
    margin-left: 0.4rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .review__dek {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.5;
  }

  .review__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .review__sep {
    color: var(--accent);
    opacity: 0.6;
  }

  .review__comments {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
  }

  .review__comments:hover {
    color: var(--accent-strong);
  }

  .review__banner {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .review__banner img {
    width: 100%;
    aspect-ratio: 1200 / 500;
    object-fit: cover;
  }

  /* Text stays ~70 characters per line for comfortable reading */
  .review__dek {
    max-width: 45rem;
  }

  /* Centred 720px reading column (~75 characters per line) under the
     1000px banner; text, images and comments all share it */
  .review__body,
  .review__comments-section,
  .review__back {
    max-width: 45rem;
    margin-inline: auto;
  }

  .review__body {
    margin-top: 2.25rem;
  }

  .review__body .prose > :global(img) {
    width: 100%;
  }

  .review__comments-section {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    /* Leave a little room above when jumping here from the Comments link */
    scroll-margin-top: 2rem;
  }

  .review__comments-section h2 {
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .review__back {
    margin-top: 2.5rem;
  }
</style>

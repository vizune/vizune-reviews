---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { about } from '../data/site';
import { IMAGE_SIZES, placeholdFor } from '../lib/placeholder';
import { getAsset } from '../lib/contentful';
import { contentfulImage, contentfulSrcset } from '../lib/images';

const [w, h] = IMAGE_SIZES.about;
const image = await getAsset(about.imageAssetId);
---

<section class="about">
  <div class="container about__grid">
    <div class="about__intro">
      <p class="about__label">{about.label}</p>
      <h2 class="about__heading display">
        {
          about.heading.map((line) => (
            <span>
              {line.map((part) => ('accent' in part ? <span class="accent">{part.text}</span> : part.text))}
            </span>
          ))
        }
      </h2>
      <p class="about__copy">{about.copy}</p>
      <Button href={about.cta.href} arrow>{about.cta.label}</Button>
    </div>

    <figure class="about__figure">
      <img
        src={image ? contentfulImage(image.url, 720) : placeholdFor('about')}
        srcset={image ? contentfulSrcset(image.url, [480, 720, 1131]) : undefined}
        sizes="(min-width: 1000px) 400px, (min-width: 640px) 50vw, 100vw"
        width={image?.width ?? w}
        height={image?.height ?? h}
        alt={image?.alt ?? ''}
        loading="lazy"
      />
      <figcaption>{about.caption[0]}<br />{about.caption[1]}</figcaption>
    </figure>

    <ul class="about__features">
      {
        about.features.map((f) => (
          <li>
            <Icon name={f.icon} size={34} class="about__icon" />
            <div>
              <h3 class="label">{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--border);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr 0.85fr;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about__label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.8rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .about__label::after {
    content: '';
    width: 3.75rem;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .about__heading {
    display: flex;
    flex-direction: column;
    margin: 1.4rem 0 1.25rem;
    font-size: clamp(1.35rem, 2.3vw, 1.7rem);
    line-height: 1.25;
  }

  .about__copy {
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .about__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--glow);
  }

  .about__figure img {
    width: 100%;
    aspect-ratio: 720 / 420;
    object-fit: cover;
  }

  /* Fade under the caption so it reads over bright artwork */
  .about__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(20deg, rgb(4 16 21 / 0.85) 0%, rgb(4 16 21 / 0.4) 30%, transparent 55%);
    pointer-events: none;
  }

  .about__figure figcaption {
    position: absolute;
    z-index: 1;
    left: 1.25rem;
    bottom: 1.4rem;
    padding-bottom: 0.6rem;
    color: var(--text);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.6);
    font-style: italic;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .about__figure figcaption::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1.75rem;
    height: 2px;
    background: var(--accent);
  }

  .about__features {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__features li {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .about__features :global(.about__icon) {
    flex-shrink: 0;
    color: var(--accent);
  }

  .about__features h3 {
    margin-bottom: 0.3rem;
    font-size: 0.65rem;
  }

  .about__features p {
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 1000px) {
    .about__grid {
      grid-template-columns: 1fr 1fr;
    }

    .about__features {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .about__grid,
    .about__features {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Icon from './Icon.astro';

interface Props {
  label: string;
  link?: { label: string; href: string };
  as?: 'h1' | 'h2';
}

const { label, link, as: Tag = 'h2' } = Astro.props;
---

<div class="section-heading">
  <Tag class="section-heading__label">{label}</Tag>
  {
    link && (
      <a class="section-heading__link label" href={link.href}>
        {link.label} <Icon name="arrow" size={14} />
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-heading__label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .section-heading__label::after {
    content: '';
    width: 3.75rem;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .section-heading__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .section-heading__link:hover {
    color: var(--accent-strong);
  }
</style>

---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  arrow?: boolean;
  /** Opens in a new tab */
  external?: boolean;
}

const { href, variant = 'outline', arrow = false, external = false } = Astro.props;
---

<a
  class:list={['btn', `btn--${variant}`]}
  href={href}
  {...(external && { target: '_blank', rel: 'noopener' })}
>
  <slot />
  {arrow && <Icon name="arrow" size={14} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.7rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition:
      background 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .btn--solid {
    background: var(--accent);
    color: var(--bg-deep);
  }

  .btn--solid:hover {
    background: var(--accent-strong);
    box-shadow: var(--glow);
  }

  .btn--outline {
    color: var(--text);
  }

  .btn--outline:hover {
    background: rgb(99 214 197 / 0.1);
    box-shadow: var(--glow);
  }
</style>

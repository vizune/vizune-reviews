---
import ComingSoonCard from './ComingSoonCard.astro';
import ReviewCard from './ReviewCard.astro';
import SectionHeading from './SectionHeading.astro';
import type { Review } from '../lib/types';

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;

// Top up the desktop row of 4 with "Coming soon" slots while there are few reviews
const COLUMNS = 4;
const fillers = Math.max(0, COLUMNS - reviews.length);
---

<section class="section">
  <div class="container">
    <SectionHeading label="Latest reviews" link={{ label: 'View all', href: '/reviews' }} />
    <div class="grid">
      {reviews.map((review, i) => <ReviewCard review={review} number={i + 1} />)}
      {
        Array.from({ length: fillers }, (_, i) => (
          <div class="filler">
            <ComingSoonCard number={reviews.length + i + 1} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  /* Wrapper keeps the filler the same height as its row neighbours */
  .filler {
    display: grid;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* "Coming soon" slots are a desktop-only touch */
    .filler {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
